{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aibaton",
  "mainBinaryName": "aibaton",
  "version": "1.0.0",
  "identifier": "com.aibaton.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aionui", "aibaton"]
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aibaton",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "object-src": "'none'",
        "frame-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Aibaton — AI agent workspace",
    "externalBin": [
      "binaries/aioncore"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        },
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "resources": {
      "binaries/managed-resources": "managed-resources"
    }
  }
}
